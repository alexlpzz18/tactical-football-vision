# Variables de entorno de Tactical Lens.
#
# Cómo usarlo: copia este archivo a .env y rellena los valores reales.
#   cp .env.example .env
# .env está en .gitignore: la clave NUNCA se commitea ni va en el código.

# Clave de la API de Anthropic para el análisis táctico con IA
# (scripts/generar_informe_v2.py --con-ia). Se obtiene en
# https://console.anthropic.com/ → API keys.
ANTHROPIC_API_KEY=
